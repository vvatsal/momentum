# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used in magic links and notification emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Phase 4 — optional until publish notifications)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Momentum <notifications@yourdomain.com>

# Seed script only — create users in Supabase Auth first or let seed create them
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_STUDENT_EMAILS=student1@example.com,student2@example.com,student3@example.com
SEED_STUDENT_PASSWORD=change-me-student-123
