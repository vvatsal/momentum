# ⚠️  COPY TO .env.local AND REPLACE WITH REAL VALUES FROM SUPABASE → API
#     Fake values cause: ENOTFOUND your-project.supabase.co

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE-WITH-YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE-WITH-ANON-KEY

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=REPLACE-WITH-SERVICE-ROLE-KEY

# App URL (used in magic links and notification emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Phase 4 — optional until publish notifications)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Momentum <notifications@yourdomain.com>

# SMTP (alternative to Resend for trial projects using personal Gmail, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM_EMAIL=Momentum <your-email@gmail.com>


# Seed script only — create users in Supabase Auth first or let seed create them
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_STUDENT_EMAILS=student1@example.com,student2@example.com,student3@example.com
SEED_STUDENT_PASSWORD=change-me-student-123
